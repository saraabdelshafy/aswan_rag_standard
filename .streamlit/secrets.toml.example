# انسخي هذا الملف باسم secrets.toml داخل نفس فولدر .streamlit للتجربة المحلية فقط.
# secrets.toml نفسه مستبعد من Git عبر .gitignore ولا يُرفع أبداً على GitHub.
# عند النشر على Streamlit Cloud: من صفحة التطبيق -> Manage app -> Secrets، الصقي نفس القيم هناك.

OPENROUTER_API_KEY = "ضعي_مفتاحك_هنا"
OPENROUTER_MODEL = "meta-llama/llama-3.1-8b-instruct:free"
